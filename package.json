{
  "name": "dsh-tailscale-serve",
  "version": "0.1.2",
  "description": "Expose the DSH web GUI on your Tailscale tailnet only — never 0.0.0.0, never the public internet.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tailscale",
    "remote-access",
    "tailnet"
  ],
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "SECURITY.md",
    "docs/**/*.md"
  ],
  "scripts": {
    "test": "node --test",
    "selfcheck": "node scripts/selfcheck.js",
    "prepublishOnly": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.3"
    }
  },
  "author": "Michael-Durant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michael-Durant/dsh-tailscale-serve.git"
  },
  "bugs": {
    "url": "https://github.com/Michael-Durant/dsh-tailscale-serve/issues"
  },
  "homepage": "https://github.com/Michael-Durant/dsh-tailscale-serve"
}
